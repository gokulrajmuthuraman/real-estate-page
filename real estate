<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DreamHome - Real Estate</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- Navigation Bar -->
    <header>
        <nav class="navbar">
            <div class="logo">Dream<span>Home</span></div>

            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a href="#properties">Properties</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>

            <a href="#contact" class="nav-btn">Get Started</a>
        </nav>
    </header>


    <!-- Hero Section -->
    <section class="hero" id="home">

        <div class="hero-content">
            <p class="small-title">WELCOME TO DREAMHOME</p>

            <h1>Find Your<br>
                <span>Dream Home</span>
            </h1>

            <p>
                Discover beautiful homes and properties that match
                your lifestyle, budget and dreams.
            </p>

            <div class="hero-buttons">
                <a href="#properties" class="primary-btn">
                    Explore Properties
                </a>

                <a href="#contact" class="secondary-btn">
                    Contact Us
                </a>
            </div>
        </div>

    </section>


    <!-- Properties Section -->
    <section class="properties" id="properties">

        <div class="section-title">
            <p>OUR PROPERTIES</p>
            <h2>Featured Properties</h2>
            <span>
                Explore our handpicked properties for your perfect home.
            </span>
        </div>

        <div class="property-container">

            <!-- Property 1 -->
            <div class="property-card">

                <div class="property-image house-one">
                    <span>For Sale</span>
                </div>

                <div class="property-content">
                    <h3>Modern Family Villa</h3>
                    <p>📍 Chennai, Tamil Nadu</p>

                    <div class="property-info">
                        <span>🛏 3 Beds</span>
                        <span>🚿 2 Baths</span>
                        <span>📐 1800 Sq.Ft</span>
                    </div>

                    <div class="property-bottom">
                        <strong>₹75 Lakhs</strong>
                        <a href="#contact">View Details</a>
                    </div>
                </div>

            </div>


            <!-- Property 2 -->
            <div class="property-card">

                <div class="property-image house-two">
                    <span>For Sale</span>
                </div>

                <div class="property-content">
                    <h3>Luxury City Apartment</h3>
                    <p>📍 Coimbatore, Tamil Nadu</p>

                    <div class="property-info">
                        <span>🛏 2 Beds</span>
                        <span>🚿 2 Baths</span>
                        <span>📐 1200 Sq.Ft</span>
                    </div>

                    <div class="property-bottom">
                        <strong>₹55 Lakhs</strong>
                        <a href="#contact">View Details</a>
                    </div>
                </div>

            </div>


            <!-- Property 3 -->
            <div class="property-card">

                <div class="property-image house-three">
                    <span>For Sale</span>
                </div>

                <div class="property-content">
                    <h3>Premium Garden House</h3>
                    <p>📍 Bangalore, Karnataka</p>

                    <div class="property-info">
                        <span>🛏 4 Beds</span>
                        <span>🚿 3 Baths</span>
                        <span>📐 2400 Sq.Ft</span>
                    </div>

                    <div class="property-bottom">
                        <strong>₹1.2 Crore</strong>
                        <a href="#contact">View Details</a>
                    </div>
                </div>

            </div>

        </div>

    </section>


    <!-- About Section -->
    <section class="about" id="about">

        <div class="about-image"></div>

        <div class="about-content">

            <p class="small-title">ABOUT DREAMHOME</p>

            <h2>We Help You Find a Place You Can Call Home</h2>

            <p>
                DreamHome is a trusted real estate platform helping
                people discover quality homes and properties.
                We make the property search simple, transparent
                and convenient.
            </p>

            <div class="features">

                <div>
                    <h3>✓ Trusted Properties</h3>
                    <p>Verified and quality properties.</p>
                </div>

                <div>
                    <h3>✓ Expert Support</h3>
                    <p>Professional guidance for buyers.</p>
                </div>

                <div>
                    <h3>✓ Affordable Prices</h3>
                    <p>Properties for different budgets.</p>
                </div>

            </div>

        </div>

    </section>


    <!-- Why Choose Us -->
    <section class="why-us">

        <div class="section-title">
            <p>WHY CHOOSE US</p>
            <h2>Making Property Search Easy</h2>
        </div>

        <div class="why-container">

            <div class="why-card">
                <div class="icon">🏠</div>
                <h3>Quality Homes</h3>
                <p>
                    Find beautiful and comfortable properties
                    suitable for your needs.
                </p>
            </div>

            <div class="why-card">
                <div class="icon">🤝</div>
                <h3>Trusted Service</h3>
                <p>
                    We provide reliable assistance throughout
                    your property journey.
                </p>
            </div>

            <div class="why-card">
                <div class="icon">💰</div>
                <h3>Best Value</h3>
                <p>
                    Discover properties with competitive
                    prices and great value.
                </p>
            </div>

        </div>

    </section>


    <!-- Contact Section -->
    <section class="contact" id="contact">

        <div class="contact-content">

            <div class="contact-text">
                <p class="small-title">GET IN TOUCH</p>

                <h2>Let's Find Your Dream Property</h2>

                <p>
                    Have questions about a property?
                    Send us a message and our team will contact you.
                </p>

                <div class="contact-details">
                    <p>📞 +91 98765 43210</p>
                    <p>📧 info@dreamhome.com</p>
                    <p>📍 Chennai, Tamil Nadu</p>
                </div>
            </div>


            <form class="contact-form">

                <input type="text"
                       placeholder="Your Name"
                       required>

                <input type="email"
                       placeholder="Your Email"
                       required>

                <input type="tel"
                       placeholder="Phone Number"
                       required>

                <textarea
                    placeholder="Your Message"
                    rows="5"
                    required></textarea>

                <button type="submit">
                    Send Message
                </button>

            </form>

        </div>

    </section>


    <!-- Footer -->
    <footer>

        <div class="footer-content">

            <div>
                <h2>Dream<span>Home</span></h2>
                <p>
                    Find your dream home with confidence.
                </p>
            </div>

            <div class="social-links">
                <a href="#">Facebook</a>
                <a href="#">Instagram</a>
                <a href="#">LinkedIn</a>
            </div>

        </div>

        <div class="copyright">
            <p>© 2026 DreamHome. All Rights Reserved.</p>
        </div>

    </footer>

</body>
</html>
